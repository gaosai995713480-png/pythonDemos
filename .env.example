# 音乐平台 Cookie 配置
# VIP 音乐需要配置对应平台的 Cookie 才能获取完整播放链接
# 从浏览器登录对应平台后，F12 -> Application -> Cookies 获取

# 网易云音乐（需要 VIP 账号）
# 必需字段：__csrf, MUSIC_U, NMTID, __remember_me
METING_NETEASE_COOKIE=

# 腾讯音乐/QQ音乐
METING_TENCENT_COOKIE=

# 酷狗音乐
METING_KUGOU_COOKIE=

# 酷我音乐
METING_KUWO_COOKIE=

# 通用 Cookie（所有平台共用，作为 fallback）
# METING_COOKIE=
